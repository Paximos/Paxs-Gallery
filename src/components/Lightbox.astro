---
// The full-screen viewer. Every [data-photo] link on the page is part of one sequence, in page order,
// so Next runs on from the end of one roll or trip into the next. Motion follows DESIGN.md, Motion.
---
<dialog class="lb" aria-labelledby="lb-title">
  <div class="lb-ground"></div>
  <div class="lb-stage"></div>
  <div class="lb-bar">
    <div class="lb-caption">
      <p class="lb-group nums"></p>
      <p id="lb-title" class="lb-title" tabindex="-1" autofocus></p>
      <p class="lb-meta small nums"></p>
      <p class="lb-status small" role="status" aria-live="polite" data-status></p>
    </div>
    <div class="lb-controls">
      <button class="lb-btn" type="button" data-prev>Previous</button>
      <button class="lb-btn" type="button" data-next>Next</button>
      <button class="lb-btn lb-share" type="button" data-share>Share</button>
      <button class="lb-btn" type="button" data-close>Close</button>
    </div>
  </div>
  <div class="lb-strip" aria-label="Frames in this set"></div>
  <div class="lb-osd" aria-hidden="true">
    <svg class="lb-osd-mark" viewBox="0 0 40 20" width="40" height="20"><path d="M20 0 0 10l20 10zM40 0 20 10l20 10z" fill="currentColor" /></svg>
    <span class="lb-osd-word"></span>
  </div>
</dialog>

<script>
  // All viewer motion runs on the Web Animations API: transform and opacity animations that Chrome hands
  // to the compositor, so a busy main thread can delay their start but never make them stutter or jump.
  import { EASE, getLenis, reduced } from '../scripts/motion';
  import { getDeveloper } from '../scripts/develop';

  const T = { open: 420, close: 260, slide: 280, fade: 160, ground: 200, chrome: 240, wipe: 300, develop: 900, developShort: 380, readout: 260 };

  const dialog = document.querySelector<HTMLDialogElement>('dialog.lb');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-photo]')];

  type Prop = 'transform' | 'opacity' | 'clipPath';

  /**
   * Animate one property of an element from wherever it is right now (mid-flight included) to `to`.
   * The end value is written to the element's style first, so nothing snaps back when the animation ends.
   */
  function run(el: HTMLElement, prop: Prop, to: string, ms: number, easing: string, from?: string) {
    const start = from ?? getComputedStyle(el)[prop];
    el.getAnimations().forEach((a) => {
      const keys = (a.effect as KeyframeEffect).getKeyframes();
      if (keys.some((k) => prop in k)) a.cancel();
    });
    el.style[prop] = to;
    if (ms <= 0 || start === to) return null;
    return el.animate([{ [prop]: start }, { [prop]: to }], { duration: ms, easing });
  }
  // Travel (moves, slides, zoom, wipes) is dropped under reduced motion; fades are kept.
  const travel = (ms: number) => (reduced() ? 0 : ms);
  const after = (a: Animation | null, fn: () => void) => (a ? a.finished.then(fn, () => {}) : fn());

  if (dialog && links.length && typeof dialog.showModal === 'function') {
    const stage = dialog.querySelector<HTMLElement>('.lb-stage')!;
    const ground = dialog.querySelector<HTMLElement>('.lb-ground')!;
    const chrome = [dialog.querySelector<HTMLElement>('.lb-bar')!, dialog.querySelector<HTMLElement>('.lb-strip')!];
    const groupEl = dialog.querySelector<HTMLElement>('.lb-group')!;
    const titleEl = dialog.querySelector<HTMLElement>('.lb-title')!;
    const metaEl = dialog.querySelector<HTMLElement>('.lb-meta')!;
    const strip = dialog.querySelector<HTMLElement>('.lb-strip')!;
    const status = dialog.querySelector<HTMLElement>('[data-status]')!;
    let statusTimer = 0;
    // A status line ('Link copied') rises in and fades out, rather than popping in and out.
    function say(text: string, ms = 1800) {
      status.textContent = text;
      clearTimeout(statusTimer);
      status.getAnimations().forEach((x) => x.cancel());
      status.animate(reduced() ? [{ opacity: 0 }, { opacity: 1 }] : [{ opacity: 0, transform: 'translateY(4px)' }, { opacity: 1, transform: 'none' }], { duration: 200, easing: EASE.out });
      if (ms) statusTimer = window.setTimeout(() => {
        status.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 150, easing: 'ease', fill: 'forwards' }).finished
          .then((x) => { status.textContent = ''; x.cancel(); }).catch(() => {});
      }, ms);
    }
    // Where a frame sits in its roll or trip: '3 of 9'.
    const placeOf = (i: number) => {
      const set = links.filter((l) => l.dataset.group === links[i].dataset.group);
      return `${set.indexOf(links[i]) + 1} of ${set.length}`;
    };
    const base = `/${location.pathname.split('/')[1]}/`;

    let img = makeImg();
    stage.append(img);

    // Film grain over a film photo at rest: a noise tile stepped at 24fps by a compositor-only animation.
    const grain = document.createElement('div');
    grain.className = 'lb-grain';
    grain.setAttribute('aria-hidden', 'true');
    stage.append(grain);
    {
      const n = document.createElement('canvas');
      n.width = n.height = 128;
      const ctx = n.getContext('2d');
      if (ctx) {
        const px = ctx.createImageData(128, 128);
        for (let k = 0; k < px.data.length; k += 4) {
          const v = 128 + (Math.random() - 0.5) * 120;
          px.data[k] = px.data[k + 1] = px.data[k + 2] = v;
          px.data[k + 3] = 255;
        }
        ctx.putImageData(px, 0, 0);
        grain.style.setProperty('--grain', `url(${n.toDataURL()})`);
      }
    }
    // Set up the darkroom while the browser is idle, so the first tap never pays for compiling a shader.
    if (!reduced()) {
      const warm = () => { getDeveloper(); };
      if ('requestIdleCallback' in window) requestIdleCallback(warm, { timeout: 4000 });
      else setTimeout(warm, 1500);
    }
    let developing = false;
    let tracking = false;
    const mediumOf = (i: number) => (links[i].dataset.href?.startsWith('/film/') ? 'film' : 'digital');
    function setGrain() {
      stage.classList.toggle('has-grain', dialog!.open && mediumOf(index) === 'film' && !zoomed && !closing && !tracking && !developing);
    }
    // Stops a develop in progress and shows the real photo in its place.
    function stopDevelop() {
      if (!developing) return;
      developing = false;
      getDeveloper()?.cancel();
      img.getAnimations().forEach((x) => { if ((x.effect as KeyframeEffect).getKeyframes().some((k) => 'opacity' in k)) x.cancel(); });
      img.style.opacity = '';
    }
    let index = 0;
    let pushed = false;
    let closing = false;
    let zoomed = false;
    let hidden: HTMLElement | null = null; // the thumbnail currently standing in for the big photo

    function makeImg() {
      const el = document.createElement('img');
      el.className = 'lb-img';
      el.alt = '';
      el.decoding = 'async';
      el.draggable = false;
      return el;
    }

    const thumbOf = (i: number) => links[i].querySelector('img')!;
    // will-change only on the photo in flight, removed as soon as it lands (DESIGN.md, Motion).
    const lift = (el: HTMLElement) => { el.style.willChange = 'transform'; };
    const land = (el: HTMLElement) => { el.style.willChange = ''; };
    // A shared element: while the big photo travels to or from a thumbnail, the thumbnail is not shown twice.
    const hideThumb = (i: number) => { showThumb(); hidden = links[i]; hidden.style.visibility = 'hidden'; };
    function showThumb() { if (hidden) hidden.style.visibility = ''; hidden = null; }

    // The thumbnail and the full photo share a shape, so one uniform scale maps one onto the other.
    const sameShape = (i: number) => {
      const r = thumbOf(i).getBoundingClientRect();
      const a = links[i];
      return r.width > 0 && Math.abs(r.width / r.height - Number(a.dataset.w) / Number(a.dataset.h)) < 0.03;
    };
    /** The transform that puts the photo (its untransformed box `box`) exactly over the rectangle `r`. */
    const onto = (r: DOMRect, box: DOMRect) =>
      `translate(${r.left + r.width / 2 - (box.left + box.width / 2)}px, ${r.top + r.height / 2 - (box.top + box.height / 2)}px) scale(${r.width / box.width})`;
    /** The photo's box as laid out, ignoring any transform it has right now. */
    function layoutBox(el: HTMLElement) {
      const keep = el.style.transform;
      el.style.transform = 'none';
      const box = el.getBoundingClientRect();
      el.style.transform = keep;
      return box;
    }

    function fill(el: HTMLImageElement, a: HTMLAnchorElement) {
      const r = Number(a.dataset.w) / Number(a.dataset.h);
      // The small thumbnail sits behind the full image while it loads.
      el.style.backgroundImage = `url("${a.dataset.thumb}")`;
      // Ask for the size the photo is actually shown at: the screen width, or less for a photo limited by height.
      el.sizes = `min(100vw, calc(${r.toFixed(4)} * (100vh - 10rem)))`;
      el.srcset = a.dataset.full ?? '';
      el.src = a.dataset.src ?? a.href;
      el.width = Number(a.dataset.w);
      el.height = Number(a.dataset.h);
      // Sized from its shape, not its pixels, so it has its final box before the image arrives.
      el.style.setProperty('--r', String(r));
      el.alt = a.querySelector('img')?.alt ?? '';
      el.onerror = () => {
        if (!a.dataset.thumb || el.src.endsWith(a.dataset.thumb)) return;
        el.removeAttribute('srcset');
        el.src = a.dataset.thumb;
        if (el === img) say("The full-size photo didn't load, so a smaller copy is showing. Check your connection and try again.", 0);
      };
    }

    function buildStrip(group: string) {
      // The strip is hidden on phones; don't spend the first frame of the open building it there.
      if (getComputedStyle(strip).display === 'none') { strip.replaceChildren(); return; }
      strip.replaceChildren(
        ...links
          .map((a, i) => ({ a, i }))
          .filter(({ a }) => a.dataset.group === group)
          .map(({ a, i }) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'lb-thumb';
            b.setAttribute('aria-label', `${a.dataset.title ?? ''}, ${placeOf(i)}`);
            if (i === index) b.setAttribute('aria-current', 'true');
            const t = document.createElement('img');
            t.src = a.dataset.thumb ?? '';
            t.alt = '';
            b.append(t);
            b.addEventListener('click', () => show(i, 'fade'));
            return b;
          }),
      );
      const current = strip.querySelector<HTMLElement>('[aria-current]');
      if (current) strip.scrollLeft = current.offsetLeft - strip.clientWidth / 2 + current.clientWidth / 2;
    }

    // ---------- zoom ----------
    const origin = { x: 50, y: 50, tx: 50, ty: 50 };
    function pan() {
      if (!zoomed) return;
      origin.x += (origin.tx - origin.x) * 0.15;
      origin.y += (origin.ty - origin.y) * 0.15;
      img.style.transformOrigin = `${origin.x}% ${origin.y}%`;
      requestAnimationFrame(pan);
    }
    function setZoom(on: boolean, x = 50, y = 50) {
      if (on === zoomed) return;
      stopDevelop();
      zoomed = on;
      stage.classList.toggle('is-zoomed', on);
      if (on) {
        origin.x = origin.tx = x; origin.y = origin.ty = y;
        img.style.transformOrigin = `${x}% ${y}%`;
        requestAnimationFrame(pan);
      }
      run(img, 'transform', on ? 'scale(2)' : 'none', travel(on ? 300 : T.close), EASE.inOut);
      setGrain();
    }
    function unzoom() {
      zoomed = false;
      stage.classList.remove('is-zoomed');
      img.style.transformOrigin = '';
    }

    // ---------- the end of the tape ----------
    // Next past the last photo goes back to the first (Previous the other way). The VCR's on-screen display
    // blinks REWIND (or FAST FORWARD), the first photo tears in like a tape catching up, and the status line
    // says it in words for screen readers.
    const osd = dialog.querySelector<HTMLElement>('.lb-osd')!;
    function rewind(back: boolean) {
      say(back ? 'Back to the end of the tape.' : 'End of the tape. Rewound to the start.', 2600);
      osd.querySelector('.lb-osd-word')!.textContent = back ? 'Fast forward' : 'Rewind';
      osd.classList.toggle('is-ff', back);
      osd.getAnimations().forEach((x) => x.cancel());
      osd.animate(
        [{ opacity: 0 }, { opacity: 1, offset: 0.08 }, { opacity: 0.25, offset: 0.2 }, { opacity: 1, offset: 0.3 }, { opacity: 1, offset: 0.82 }, { opacity: 0 }].map((k) => ({ ...k, easing: 'steps(1, end)' })),
        { duration: 1300 },
      );
      if (reduced()) return;
      img.animate([
        { clipPath: 'inset(0 0 72% 0)', transform: 'translateX(-4%)', easing: 'steps(1, end)' },
        { clipPath: 'inset(38% 0 22% 0)', transform: 'translateX(3%)', offset: 0.25, easing: 'steps(1, end)' },
        { clipPath: 'inset(8% 0 48% 0)', transform: 'translateX(-2%)', offset: 0.5, easing: 'steps(1, end)' },
        { clipPath: 'inset(0 0 12% 0)', transform: 'translateX(1%)', offset: 0.75, easing: 'steps(1, end)' },
        { clipPath: 'inset(0 0 0 0)', transform: 'none' },
      ], { duration: 360, composite: 'add' });
    }

    // ---------- changing frames ----------
    // instant: swap in place · fade: crossfade (buttons, strip) · swipe: the caller moves the photos
    type Mode = 'instant' | 'fade' | 'swipe';
    function show(i: number, mode: Mode = 'instant') {
      const prevGroup = links[index]?.dataset.group;
      stopDevelop();
      index = (i + links.length) % links.length;
      const a = links[index];
      if (zoomed) unzoom();

      if (mode === 'swipe') {
        fill(img, a);
      } else if (dialog!.open && mode === 'fade') {
        // The old photo stays as a copy and fades out while the new one fades in over it.
        const old = img;
        img = makeImg();
        fill(img, a);
        stage.append(img);
        run(img, 'opacity', '1', T.fade, 'ease', '0');
        after(run(old, 'opacity', '0', T.fade, 'ease'), () => old.remove());
      } else {
        stage.querySelectorAll('.lb-img').forEach((el) => el !== img && el.remove());
        img.getAnimations().forEach((x) => x.cancel());
        img.style.transform = '';
        img.style.opacity = '';
        fill(img, a);
      }

      const crossed = dialog!.open && prevGroup !== a.dataset.group;
      groupEl.textContent = a.dataset.group ?? '';
      groupEl.classList.toggle('is-new', crossed);
      if (crossed && !reduced()) run(groupEl, 'clipPath', 'inset(0 0% 0 0)', T.wipe, EASE.out, 'inset(0 100% 0 0)');
      titleEl.textContent = a.dataset.title ?? '';
      metaEl.textContent = [a.dataset.meta, placeOf(index)].filter(Boolean).join(' · ');
      // the caption changes with the photo: it fades in over the same 160ms as the crossfade (keys stay instant)
      if (dialog!.open && mode === 'fade') for (const el of [titleEl, metaEl]) run(el, 'opacity', '1', T.fade, 'ease', '0');
      status.textContent = '';
      // Past the last frame Next goes back to the first (and Previous the other way): say so, like a tape rewinding.
      if (dialog!.open && links.length > 1 && (i >= links.length || i < 0)) rewind(i < 0);
      buildStrip(a.dataset.group ?? '');
      grain.style.setProperty('--r', img.style.getPropertyValue('--r'));
      if (mode !== 'swipe') setGrain(); // a swipe restores it once the photo lands
      if (dialog!.open) history.replaceState({ lb: true }, '', a.dataset.href);
    }

    function resetChrome() {
      [dialog!, ground, ...chrome].forEach((el) => {
        el.getAnimations().forEach((x) => x.cancel());
        el.style.opacity = '';
        el.style.transform = '';
      });
    }

    // ---------- opening ----------
    type How = 'pointer' | 'key' | 'deep';
    function open(i: number, how: How) {
      closing = false;
      // Measure the touched thumbnail before anything changes, so the photo starts from exactly there.
      const from = thumbOf(i).getBoundingClientRect();
      const grow = how === 'pointer' && !reduced() && sameShape(i);
      show(i, 'instant');
      const href = links[index].dataset.href;
      if (how === 'deep') { history.replaceState({ lb: true }, '', href); pushed = false; }
      else { history.pushState({ lb: true }, '', href); pushed = true; }
      resetChrome();
      dialog!.showModal();
      getLenis()?.stop();

      if (how === 'deep') return;
      if (!grow) { run(dialog!, 'opacity', '1', 150, 'linear', '0'); return; }

      // The photo grows out of the thumbnail; the thumbnail steps aside so there is only ever one.
      hideThumb(index);
      lift(img);
      const flying = img;
      const start = onto(from, img.getBoundingClientRect());
      after(run(img, 'transform', 'none', T.open, EASE.out, start), () => { land(flying); showThumb(); });
      run(ground, 'opacity', '1', T.ground, 'linear', '0');

      // The darkroom: the photo develops (film) or is read off the sensor (mirrorless) as it grows.
      const dev = getDeveloper();
      const source = thumbOf(index);
      if (dev && source.complete && source.naturalWidth) {
        const medium = mediumOf(index);
        dev.canvas.style.setProperty('--r', img.style.getPropertyValue('--r'));
        stage.append(dev.canvas);
        developing = true;
        setGrain();
        img.style.opacity = '0';
        run(dev.canvas, 'transform', 'none', T.open, EASE.out, start);
        const developed = img;
        let firstOfVisit = true;
        try { firstOfVisit = !sessionStorage.getItem('pax-developed'); sessionStorage.setItem('pax-developed', '1'); } catch { /* storage blocked: treat as first */ }
        const ms = medium === 'film' ? (firstOfVisit ? T.develop : T.developShort) : T.readout;
        dev.play(source, medium, ms).then(async (done) => {
          if (!done || developed !== img || !developing) return;
          // Hold the finished print until the sharp photo is decoded (at most 700ms), so the hand-over lands sharp.
          await Promise.race([img.decode().catch(() => {}), new Promise((r) => setTimeout(r, 700))]);
          if (developed !== img || !developing) return;
          developing = false;
          // Hand over from the developed print to the full-resolution photo.
          after(run(img, 'opacity', '1', T.fade, 'ease', '0'), () => { if (!developing) dev.cancel(); });
          setGrain();
        });
      }
      chrome.forEach((el) => el.animate(
        [{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }],
        { duration: T.chrome, delay: 120, easing: EASE.out, fill: 'backwards' },
      ));
    }

    // ---------- closing ----------
    function finish(fromPop: boolean) {
      if (dialog!.open) dialog!.close();
      closing = false;
      unzoom();
      showThumb();
      land(img);
      img.getAnimations().forEach((x) => x.cancel());
      img.style.transform = '';
      resetChrome();
      if (!fromPop && history.state?.lb) {
        if (pushed) history.back();
        else history.replaceState(null, '', base);
      }
      pushed = false;
      getLenis()?.start();
      setGrain();
      links[index]?.focus({ preventScroll: true });
    }

    function requestClose(fromPop = false) {
      if (!dialog!.open || closing) return;
      stopDevelop();
      closing = true;
      setGrain();
      stage.querySelectorAll('.lb-img').forEach((el) => el !== img && el.remove());

      // Bring the current frame's thumbnail into view so the photo has somewhere to return to.
      const thumb = thumbOf(index);
      let r = thumb.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) {
        const lenis = getLenis();
        const y = scrollY + r.top - innerHeight / 2 + r.height / 2;
        if (lenis) lenis.scrollTo(y, { immediate: true, force: true });
        else window.scrollTo(0, y);
        r = thumb.getBoundingClientRect();
      }
      // A frame still waiting to reveal must be there to land on.
      const cell = links[index].closest<HTMLElement>('[data-reveal]');
      if (cell) { cell.style.transition = 'none'; cell.dataset.reveal = 'in'; requestAnimationFrame(() => { cell.style.transition = ''; }); }

      if (reduced() || !sameShape(index)) {
        after(run(dialog!, 'opacity', '0', 150, 'linear'), () => finish(fromPop));
        return;
      }
      // From wherever the photo is now (mid-open, dragged down, zoomed) straight back into its thumbnail.
      const now = getComputedStyle(img).transform;
      if (zoomed) unzoom();
      hideThumb(index);
      lift(img);
      after(run(img, 'transform', onto(r, layoutBox(img)), T.close, EASE.out, now), () => finish(fromPop));
      run(ground, 'opacity', '0', T.close, 'linear');
      chrome.forEach((el) => run(el, 'opacity', '0', 120, 'linear'));
    }

    // Escape runs the same close as the button instead of snapping shut.
    dialog.addEventListener('cancel', (e) => { e.preventDefault(); requestClose(); });
    // If the browser closes the dialog itself, tidy up.
    dialog.addEventListener('close', () => {
      if (closing) return;
      showThumb();
      resetChrome();
      getLenis()?.start();
    });
    window.addEventListener('popstate', () => { if (dialog.open && !history.state?.lb) { pushed = false; requestClose(true); } });

    links.forEach((a, i) => a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      open(i, e.detail === 0 ? 'key' : 'pointer'); // detail 0: Enter on a focused frame
    }));

    dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(index - 1, 'fade'));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => show(index + 1, 'fade'));
    dialog.querySelector('[data-close]')!.addEventListener('click', () => requestClose());
    dialog.querySelector('[data-share]')!.addEventListener('click', async () => {
      const url = new URL(links[index].dataset.href ?? '', location.origin).href;
      try {
        if (navigator.share) await navigator.share({ title: `${links[index].dataset.title} · Pax's`, url });
        else { await navigator.clipboard.writeText(url); say('Link copied'); }
      } catch { /* the visitor cancelled the share sheet */ }
    });

    // Keyboard frame changes are instant: they repeat too often to animate.
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1, 'instant');
      if (e.key === 'ArrowRight') show(index + 1, 'instant');
    });

    // ---------- pointer: click or double-tap to zoom, move to look around ----------
    let lastTap = 0;
    let moved = false;
    stage.addEventListener('pointerup', (e) => {
      if (moved || closing || !(e.target as HTMLElement).classList.contains('lb-img')) return;
      const r = layoutBox(img);
      const x = ((e.clientX - r.left) / r.width) * 100;
      const y = ((e.clientY - r.top) / r.height) * 100;
      if (e.pointerType === 'mouse') { setZoom(!zoomed, x, y); return; }
      const now = Date.now();
      if (now - lastTap < 300) setZoom(!zoomed, x, y);
      lastTap = now;
    });
    stage.addEventListener('pointermove', (e) => {
      if (!zoomed) return;
      const r = stage.getBoundingClientRect();
      origin.tx = ((e.clientX - r.left) / r.width) * 100;
      origin.ty = ((e.clientY - r.top) / r.height) * 100;
    });

    // ---------- touch: the photo follows the finger ----------
    let sx = 0, sy = 0, bx = 0, by = 0, t0 = 0, axis: 'x' | 'y' | null = null;
    stage.addEventListener('touchstart', (e) => {
      moved = false;
      if (zoomed || closing || e.touches.length > 1) { tracking = false; return; }
      tracking = true; axis = null;
      stopDevelop();
      setGrain();
      sx = e.touches[0].clientX; sy = e.touches[0].clientY; t0 = performance.now();
      // Catch the photo where it is if it is still settling, and carry on from there.
      const m = new DOMMatrix(getComputedStyle(img).transform === 'none' ? undefined : getComputedStyle(img).transform);
      img.getAnimations().forEach((x) => x.cancel());
      bx = m.m41; by = m.m42;
      img.style.transform = `translate(${bx}px, ${by}px)`;
      lift(img);
    }, { passive: true });
    stage.addEventListener('touchmove', (e) => {
      if (!tracking || e.touches.length > 1) return;
      const dx = e.touches[0].clientX - sx;
      const dy = e.touches[0].clientY - sy;
      if (!axis && Math.hypot(dx, dy) > 8) axis = Math.abs(dx) > Math.abs(dy) ? 'x' : dy > 0 ? 'y' : null;
      if (!axis) return;
      moved = true;
      if (axis === 'x') img.style.transform = `translate(${bx + dx}px, 0px)`;
      else {
        const d = Math.max(0, dy);
        img.style.transform = `translate(0px, ${by + d}px)`;
        ground.style.opacity = String(1 - Math.min(d / 400, 0.6));
        chrome.forEach((el) => { el.style.opacity = String(1 - Math.min(d / 120, 1)); });
      }
    }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (!tracking || !axis) { tracking = false; land(img); setGrain(); return; }
      tracking = false;
      const dx = e.changedTouches[0].clientX - sx;
      const dy = e.changedTouches[0].clientY - sy;
      const elapsed = Math.max(1, performance.now() - t0);
      if (axis === 'x') {
        const fast = Math.abs(dx) / elapsed > 0.11;
        if (Math.abs(dx) > stage.clientWidth * 0.3 || fast) {
          // The touched photo carries on off screen; the next one arrives right behind it.
          const dir = dx < 0 ? 1 : -1;
          const w = stage.clientWidth;
          const leaving = img;
          stage.querySelectorAll('.lb-img').forEach((el) => el !== leaving && el.remove());
          img = makeImg();
          stage.append(img);
          show(index + dir, 'swipe');
          lift(img);
          const arriving = img;
          after(run(img, 'transform', 'none', travel(T.slide), EASE.drawer, `translate(${dir * w + bx + dx}px, 0px)`), () => { land(arriving); setGrain(); });
          after(run(leaving, 'transform', `translate(${-dir * w}px, 0px)`, travel(T.slide), EASE.drawer), () => leaving.remove());
        } else {
          after(run(img, 'transform', 'none', travel(T.slide), EASE.drawer), () => { land(img); setGrain(); });
        }
      } else {
        const d = Math.max(0, dy);
        if (d > 90 || d / elapsed > 0.11) requestClose();
        else {
          after(run(img, 'transform', 'none', travel(T.close), EASE.drawer), () => { land(img); setGrain(); });
          run(ground, 'opacity', '1', T.close, EASE.drawer);
          chrome.forEach((el) => run(el, 'opacity', '1', T.close, EASE.drawer));
        }
      }
    });

    // A deep link (/film/roll-001/13/) opens straight onto its frame.
    const initial = document.body.dataset.initial;
    if (initial) {
      const i = links.findIndex((a) => a.dataset.href === initial);
      if (i >= 0) open(i, 'deep');
    }
  }
</script>

