---
// A shareable link to one film frame: the contact sheets with the lightbox open on that frame.
import { getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Sheets from '../../../components/Sheets.astro';
import { caption, loadPhotos, type Photo } from '../../../lib/photos';

export async function getStaticPaths() {
  const { film } = await loadPhotos();
  return film.flatMap((g) => g.photos.map((p) => ({
    params: { roll: g.id, frame: String(p.frame ?? p.index) },
    props: { photo: p, label: g.label },
  })));
}

const { photo, label } = Astro.props as { photo: Photo; label: string };
const { film } = await loadPhotos();
const og = await getImage({ src: photo.image, width: 1200, format: 'jpg' });
---
<Base title={`${caption(photo)} · ${label} · Pax's`} description={photo.alt} current="film" ogImage={new URL(og.src, Astro.url).href} initial={photo.href}>
  <Sheets collection="film" groups={film} />
</Base>
